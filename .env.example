# Image published by the GitHub Actions workflow.
GBFS_IMAGE=ghcr.io/colombiatransit/gbfs-colombia:latest

# Only explicitly selected Colombian provider IDs are scheduled.
ENABLED_NETWORKS=encicla,tembici-bogota
UPDATE_INTERVAL_SECONDS=180

# No TCP ports are published on the host. Compose creates this named bridge
# network and Traefik / OTP can join it via external: true.
GBFS_SHARED_NETWORK=gbfs-colombia-shared

# Traefik routing is opt-in; do not expose until your HTTPS domain is ready.
GBFS_TRAEFIK_ENABLED=false
GBFS_TRAEFIK_HOST=gbfs.invalid
GBFS_TRAEFIK_ENTRYPOINT=websecure

# REQUIRED for compliant GBFS 3.0; use an address you actually monitor.
GBFS_CONTACT_EMAIL=

# OSM opening_hours syntax. Unknown is not the same as open 24/7.
# Replace these when the official operators' opening hours are verified.
GBFS_OPENING_HOURS=24/7 unknown
GBFS_OPENING_HOURS_ENCICLA=
GBFS_OPENING_HOURS_TEMBICI_BOGOTA=
